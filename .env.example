# PAIMANA Infrastructure Intelligence Platform Configuration

# System & Server Settings
PORT=8000
NODE_ENV=development
LOG_LEVEL=INFO
CORS_ORIGIN=*

# Supabase PostgreSQL & Vector Database Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Provider Configuration ("gemini", "openai", "local", "auto")
LLM_PROVIDER=auto
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-1.5-pro

# External ML Service Integration Configuration
ML_SERVICE_URL=http://localhost:8000/api/v1/predict/risk
ML_SERVICE_TIMEOUT=10.0

# Document Embeddings & Vector RAG Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=all-MiniLM-L6-v2
DOCUMENT_STORAGE_BUCKET=project-documents

# Rate Limiting & Safety Controls
MAX_LLM_CALLS_PER_MINUTE=35
MAX_LLM_CALLS_PER_HOUR=2000
MIN_COOLDOWN_SECONDS=2
